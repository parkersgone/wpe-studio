# Copy to .env next to compose.yml and adjust.
#
# Where you built linux-wallpaperengine. The binary's RPATH holds absolute
# paths into this tree, so it is mounted at the same path inside the container.
WPE_ENGINE_SRC=/opt/linux-wallpaperengine

# Bind address for the daemon. Anything other than loopback makes it require a
# token -- see the HTTP API section of the README.
WPE_BIND=127.0.0.1
WPE_PORT=8014
